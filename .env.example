# ==============================================================================
# WIREDROP FASTHOSTING CONFIGURATION
# Sao chép tệp này thành .env:
#   cp .env.example .env (Linux/macOS) hoặc copy .env.example .env (Windows)
# ==============================================================================

# 1. Cổng lắng nghe nội bộ của máy chủ WireDrop (Mặc định: 8080)
PORT=8080

# 2. Token của Cloudflare Named Tunnel (Dành cho Option 2: Domain cá nhân cố định)
# Lấy Token tại: Cloudflare Dashboard > Zero Trust > Networks > Tunnels
# Tạo 1 tunnel mới, copy chuỗi Token dạng: eyJhIjoi...
# Để trống nếu chỉ muốn dùng Option 1 (Domain ngẫu nhiên miễn phí *.trycloudflare.com)
CLOUDFLARE_TUNNEL_TOKEN=

# 3. Domain cá nhân bạn đã gán cho Tunnel trên Cloudflare (Dùng để in link đẹp trên Terminal)
# Ví dụ: w.yourdomain.com hoặc drop.mydomain.net
CUSTOM_DOMAIN=

